<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The webhook, handled now or from the queue (Zero Checkout > Payment Webhooks). -->
    <type name="Zero\Checkout\Model\RedirectPayment\Webhooks">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="zero_klarna" xsi:type="object">Zero\Klarna\Model\OrderUpdater</item>
            </argument>
        </arguments>
    </type>
    <!-- Asked about pending orders by the recheck cron (Zero Checkout > Payment Webhooks > Recheck Pending Payments). -->
    <type name="Zero\Checkout\Model\RedirectPayment\Updaters">
        <arguments>
            <argument name="updaters" xsi:type="array">
                <item name="zero_klarna" xsi:type="object">Zero\Klarna\Model\OrderUpdater</item>
            </argument>
        </arguments>
    </type>
</config>
